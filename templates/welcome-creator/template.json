  "name": "Welcome · newsletter",
  "description": "What to expect, three best-of posts to start with, and a question to reply to.",
  "subject": "You're in. Here's what to expect.",
  "body_text": "{{headline}}\n\nHi {{first_name|there}},\n{{intro}}\n\n{{start_here_intro}}\n\n{{post_1_title}}: {{post_1_url}}\n{{post_1_note}}\n{{post_2_title}}: {{post_2_url}}\n{{post_2_note}}\n{{post_3_title}}: {{post_3_url}}\n{{post_3_note}}\n\n{{question}} {{question_body}}\n\n{{sender_initials}}\n\n{{sender_name}}\n{{sender_role}}, {{company_name}}\n\nUnsubscribe: {{unsubscribe_url}}",
  "brief": {
    "job": "Build the reading habit and earn a reply in week one.",
    "send_when": "Right after confirmation.",
    "metric": "Reply rate and second-issue open rate",
    "mechanic": "Sets expectations (cadence), hands over the best work so the first impression is the best, then asks a question to get a reply (which also trains inbox placement).",
    "subject_variants": [
      "You're in. Here's what to expect.",
      "Welcome! Start with these three",
      "Thanks for subscribing, {{first_name|there}}"
    ],
    "keep": [
      "cadence promise",
      "best-of links",
      "the reply question"
    ],
    "avoid": [
      "a sales pitch in the welcome"
    ],
    "imagery": {
      "default": "none"
    }
  },
