  "brief": {
    "job": "Fill tables (or the counter) this week.",
    "send_when": "Weekly, early in the week.",
    "metric": "Bookings and visits",
    "mechanic": "A menu feels like an invitation, not an ad; limited-time specials give a reason to come this week.",
