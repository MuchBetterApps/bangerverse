{
  "id": "impact-report",
  "version": 3,
  "category": "broadcast",
  "message_kind": "digest",
  "family": "report",
  "stage": "publish",
  "businesses": [
    "community",
    "services"
  ],
  "name": "Impact report",
  "description": "What supporters made possible: big numbers, one story, and a thank-you.",
  "subject": "What you made possible in {{period}}",
  "body_text": "{{period}}\nWhat you made possible, {{first_name|there}}\n\n{{stat_1_label}}\n{{stat_1}}\n\n{{stat_2_label}}\n{{stat_2}}\n\n{{stat_3_label}}\n{{stat_3}}\n\n{{story_quote}}\n{{story_attribution}}\n\n{{thanks}}\n{{cta_label}}: {{cta_url}}\n\nUnsubscribe: {{unsubscribe_url}}",
  "brief": {
    "job": "Show supporters their impact so they give again.",
    "send_when": "Quarterly or yearly.",
    "metric": "Repeat donations and replies",
    "mechanic": "Credit the reader ('you made this'), make impact concrete, then invite the next step softly.",
    "subject_variants": [
      "What you made possible in {{period}}",
      "1,000 trees, thanks to you",
      "Your {{period}} impact report"
    ],
    "keep": [
      "numbers credited to supporters",
      "one story"
    ],
    "avoid": [
      "an ask in the first half"
    ],
    "imagery": {
      "default": "brand art: blocks",
      "slot": "hero_image"
    }
  },
  "slots": [
    {
      "key": "preheader",
      "label": "Preview text",
      "type": "text",
      "help": "Shown next to the subject in the inbox."
    },
    {
      "key": "hero_image",
      "label": "Hero image",
      "type": "image"
    },
    {
      "key": "period",
      "label": "Period",
      "type": "text"
    },
    {
      "key": "stat_1_label",
      "label": "Stat 1 label",
      "type": "text"
    },
    {
      "key": "stat_1",
      "label": "Stat 1",
      "type": "text"
    },
    {
      "key": "stat_2_label",
      "label": "Stat 2 label",
      "type": "text"
    },
    {
      "key": "stat_2",
      "label": "Stat 2",
      "type": "text"
    },
    {
      "key": "stat_3_label",
      "label": "Stat 3 label",
      "type": "text"
    },
    {
      "key": "stat_3",
      "label": "Stat 3",
      "type": "text"
    },
    {
      "key": "story_quote",
      "label": "Story quote",
      "type": "text"
    },
    {
      "key": "story_attribution",
      "label": "Story attribution",
      "type": "text"
    },
    {
      "key": "thanks",
      "label": "Thanks",
      "type": "paragraph"
    },
    {
      "key": "cta_label",
      "label": "Button label",
      "type": "text"
    },
    {
      "key": "cta_url",
      "label": "Button link",
      "type": "url",
      "help": "A full https link. Required before sending."
    }
  ],
  "content": {
    "preheader": "1,000 trees, 214 volunteers, and one very good Saturday.",
    "hero_image": "https://images.pexels.com/photos/29861626/pexels-photo-29861626.jpeg?auto=compress&cs=tinysrgb&w=1200&h=560&fit=crop",
    "period": "2026",
    "stat_1_label": "Trees planted",
    "stat_1": "1,000",
    "stat_2_label": "Volunteers",
    "stat_2": "214",
    "stat_3_label": "Survival rate",
    "stat_3": "92%",
    "story_quote": "My daughter planted tree #412. We visit it every Sunday.",
    "story_attribution": "Joana, neighbour and volunteer",
    "thanks": "None of this happens without you. Thank you. Next year's goal is 2,000 trees, and the first planting day is March 8.",
    "cta_label": "See the full report",
    "cta_url": ""
  }
}
