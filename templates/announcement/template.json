{
  "id": "announcement",
  "version": 3,
  "category": "broadcast",
  "message_kind": "announcement",
  "family": "spotlight",
  "stage": "publish",
  "businesses": [
    "saas",
    "shop",
    "creator",
    "services",
    "local",
    "community"
  ],
  "name": "Announcement",
  "description": "Your own hero image (or brand art), one headline, one reason to care, one button.",
  "subject": "{{headline}}",
  "body_text": "{{eyebrow}}\n{{headline}}\n{{summary}}\n{{cta_label}}: {{cta_url}}\n\nUnsubscribe: {{unsubscribe_url}}",
  "brief": {
    "job": "Tell the whole list one important thing and get the click.",
    "send_when": "Any single piece of news.",
    "metric": "Click rate",
    "mechanic": "Image, headline, one paragraph, one button: nothing competes with the news.",
    "subject_variants": [
      "{{headline}}",
      "News from {{company_name}}",
      "{{first_name|there}}, this one's big"
    ],
    "keep": [
      "one piece of news"
    ],
    "avoid": [
      "a second story"
    ],
    "imagery": {
      "default": "the brand's own hero image, or brand art",
      "slot": "hero_image",
      "photo_idea": "bright workspace morning light"
    }
  },
  "slots": [
    {
      "key": "preheader",
      "label": "Preview text",
      "type": "text",
      "help": "Shown next to the subject in the inbox."
    },
    {
      "key": "hero_image",
      "label": "Hero image",
      "type": "image"
    },
    {
      "key": "hero_alt",
      "label": "Hero alt",
      "type": "text"
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "type": "text"
    },
    {
      "key": "headline",
      "label": "Headline",
      "type": "text"
    },
    {
      "key": "summary",
      "label": "Summary",
      "type": "paragraph"
    },
    {
      "key": "cta_label",
      "label": "Button label",
      "type": "text"
    },
    {
      "key": "cta_url",
      "label": "Button link",
      "type": "url",
      "help": "A full https link. Required before sending."
    }
  ],
  "content": {
    "preheader": "The short version, and what it means for you.",
    "hero_image": "https://images.pexels.com/photos/6850547/pexels-photo-6850547.jpeg?auto=compress&cs=tinysrgb&w=1200&h=560&fit=crop",
    "hero_alt": "Our new studio in Porto",
    "eyebrow": "News",
    "headline": "We're opening a second studio",
    "summary": "Starting October 6 you'll find us in Porto too: same hands, same kilns, and a workshop space for evening classes.",
    "cta_label": "Read the news",
    "cta_url": ""
  }
}
