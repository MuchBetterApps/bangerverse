  "name": "New collection",
  "description": "A hero image and a two-by-two product grid with prices, then one 'shop all'.",
  "subject": "New: {{collection_name}}",
  "body_text": "New collection\n{{collection_name}}\n{{summary}}\n\n{{product_1_name}}: {{product_1_url}}\n{{product_1_detail}}\n{{product_1_price}}\n\n{{product_2_name}}: {{product_2_url}}\n{{product_2_detail}}\n{{product_2_price}}\n\n{{product_3_name}}: {{product_3_url}}\n{{product_3_detail}}\n{{product_3_price}}\n\n{{product_4_name}}: {{product_4_url}}\n{{product_4_detail}}\n{{product_4_price}}\n\n{{cta_label}}: {{cta_url}}\n\nUnsubscribe: {{unsubscribe_url}}",
  "brief": {
    "job": "Sell a new collection.",
    "send_when": "Launch day (VIPs first, a day earlier).",
    "metric": "Revenue per recipient",
    "mechanic": "A visual grid lets people shop from the email; small-batch honesty adds urgency without tricks.",
    "subject_variants": [
      "New: {{collection_name}}",
      "Four new pieces, just out of the kiln",
      "The {{collection_name}} collection is here"
    ],
    "keep": [
