  "name": "Order confirmed",
  "description": "What they bought with pictures, when it arrives, and where it's going.",
  "subject": "Order {{order_id}} confirmed: arriving {{delivery_estimate}}",
  "body_text": "Order {{order_id}}\nThanks, {{first_name|there}}. It's on the wheel.\nArriving {{delivery_estimate}}. We'll email you tracking as soon as it ships.\n\nConfirmed Packed Shipped Delivered\n\n{{item_1_name}}\n{{item_1_detail}} {{item_1_price}}\n\n{{item_2_name}}\n{{item_2_detail}} {{item_2_price}}\n\nShipping {{shipping}}\nTotal {{total}}\n\nShipping to\n{{address}} Paid with\n{{payment_method}}\n\n{{cta_label}}: {{cta_url}}",
  "brief": {
    "job": "Reassure the buyer and prevent 'did my order go through?' tickets.",
    "send_when": "Immediately after checkout.",
    "metric": "Order-status tickets per 100 orders",
    "mechanic": "Pictures of what they bought make the moment feel real; the delivery estimate answers the next question before it's asked.",
    "subject_variants": [
      "Order {{order_id}} confirmed: arriving {{delivery_estimate}}",
      "Thanks, {{first_name|there}}! Your order is in",
      "We've got your order"
    ],
    "keep": [
      "item photos",
      "delivery estimate",
      "address"
    ],
    "avoid": [
      "cross-sells above the order"
    ],
    "imagery": {
      "default": "product photos",
      "slot": "item_1_image",
      "photo_idea": "product flat lay neutral background"
    }
  },
